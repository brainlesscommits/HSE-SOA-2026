{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "com.cinema.events",
  "doc": "Schema v1 for online cinema user activity events",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID of the event"
    },
    {
      "name": "user_id",
      "type": "string",
      "doc": "User identifier"
    },
    {
      "name": "movie_id",
      "type": "string",
      "doc": "Movie identifier"
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "VIEW_STARTED",
          "VIEW_FINISHED",
          "VIEW_PAUSED",
          "VIEW_RESUMED",
          "LIKED",
          "SEARCHED"
        ]
      },
      "doc": "Type of user action"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Event timestamp in UTC milliseconds"
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": [
          "MOBILE",
          "DESKTOP",
          "TV",
          "TABLET"
        ]
      },
      "doc": "Client device type"
    },
    {
      "name": "session_id",
      "type": "string",
      "doc": "Viewing session identifier"
    },
    {
      "name": "progress_seconds",
      "type": "int",
      "doc": "Playback progress in seconds"
    }
  ]
}
